{
  "manifest_version": 3,
  "name": "TC-Block - Báo Cáo & Chặn Kênh YouTube",
  "version": "1.0.0",
  "description": "Báo cáo và tự động ẩn các kênh YouTube rác, giật gân, lừa đảo hoặc vi phạm bản quyền dùng chung cho cộng đồng.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TC-Block - Quản lý kênh bị chặn",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
